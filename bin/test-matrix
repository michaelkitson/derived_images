#!/usr/bin/env bash
# Runs the test suite in Docker against supported Ruby/Rails pairs: [JOBS=n] bin/test-matrix [test args]
# Not a full cross product: Rails only supports a window of Rubies, so this lists the pairs worth running.
# An empty Rails version means the newest Rails that installs on that Ruby.
# JOBS (default 1) is how many pairs run at once. With JOBS=1 output streams live; with more, each
# pair's output is buffered and the logs of failures are printed at the end.
set -uo pipefail
cd "$(dirname "$0")/.." || exit 1

pairs=(
  "2.7|~> 7.0.0"
  "2.7|~> 7.1.0"
  "3.0|~> 7.1.0"
  "3.1|~> 7.2.0"
  "3.2|~> 7.0.0"
  "3.2|"
  "3.3|~> 7.2.0"
  "3.3|~> 8.0.0"
  "3.4|"
  "4.0|"
)
jobs="${JOBS:-1}"
if ! [[ "$jobs" =~ ^[1-9][0-9]*$ ]]; then
  echo "JOBS must be a positive integer (got '$jobs')" >&2
  exit 1
fi

# Runs one pair, given as "<n>|<ruby>|<rails>" followed by test args; writes its label to
# $workdir/<n>.failed on failure. Invoked by xargs via --run-pair below.
run_pair() {
  IFS='|' read -r n ruby rails <<< "$1"
  shift
  local label="Ruby $ruby / Rails ${rails:-latest}"
  if ((jobs == 1)); then
    echo "=== $label ==="
    RUBY_VERSION=$ruby RAILS_VERSION=$rails bin/in-docker test "$@" || echo "$label" > "$workdir/$n.failed"
  elif RUBY_VERSION=$ruby RAILS_VERSION=$rails bin/in-docker test "$@" > "$workdir/$n.log" 2>&1; then
    echo "PASS: $label"
  else
    echo "FAIL: $label"
    echo "$label" > "$workdir/$n.failed"
  fi
}

if [[ "${1:-}" == "--run-pair" ]]; then
  shift
  run_pair "$@"
  exit 0
fi

workdir="$(mktemp -d)"
trap 'rm -rf "$workdir"' EXIT
export jobs workdir

n=0
for pair in "${pairs[@]}"; do
  n=$((n + 1))
  echo "$n|$pair"
done | xargs -P "$jobs" -I{} "$0" --run-pair {} "$@"

failed=()
for n in $(seq 1 ${#pairs[@]}); do
  [[ -f "$workdir/$n.failed" ]] || continue
  label="$(cat "$workdir/$n.failed")"
  failed+=("$label")
  if ((jobs > 1)); then
    echo "=== $label (output) ===" >&2
    cat "$workdir/$n.log" >&2
  fi
done

if ((${#failed[@]})); then
  printf 'FAILED: %s\n' "${failed[@]}" >&2
  exit 1
fi
echo "All combinations passed"
