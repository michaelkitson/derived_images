#!/usr/bin/env ruby
# frozen_string_literal: true

require 'bundler/setup'
require 'derived_images'

table = DerivedImages::FormatSupport.table(:mini_magick)
width = table.map { |k, _v| k.length }.max + 1

# MiniMagick.cli was removed in MiniMagick 5, which uses a `graphicsmagick` flag instead.
cli =
  if MiniMagick.respond_to?(:cli) then MiniMagick.cli
  elsif MiniMagick.graphicsmagick then :graphicsmagick
  else :imagemagick
  end
puts "MiniMagick CLI Version: #{cli}@#{MiniMagick.cli_version}"
puts 'Supported Formats:'
table.each { |name, supported| puts "#{"#{name}:".ljust(width, ' ')} #{supported ? '✅' : '❌'}" }
