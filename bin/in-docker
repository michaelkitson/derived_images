#!/usr/bin/env bash
# Runs a binstub inside a clean Linux container: bin/in-docker <binstub> [args]
#   bin/in-docker test
#   bin/in-docker test test/smoke_test.rb
#   bin/in-docker vips_info
#   RUBY_VERSION=2.7 bin/in-docker test
#   RUBY_VERSION=3.2 RAILS_VERSION='~> 7.0.0' bin/in-docker test
set -euo pipefail
cd "$(dirname "$0")/.."

unsupported=(in-docker release test-matrix)

available=()
for path in bin/*; do
  name="$(basename "$path")"
  [[ " ${unsupported[*]} " == *" $name "* ]] || available+=("$name")
done

binstub="${1:-}"
if [[ -z "$binstub" || " ${available[*]} " != *" $binstub "* ]]; then
  echo "Usage: bin/in-docker <binstub> [args]" >&2
  echo "Available binstubs: ${available[*]}" >&2
  exit 1
fi
shift

ruby_version="${RUBY_VERSION:-4.0}"
rails_version="${RAILS_VERSION:-}"
# Tag by Ruby and Rails so each combination keeps its own cached image ("~> 7.0.0" becomes "7.0.0").
image="derived_images:${ruby_version}-rails$(echo "${rails_version:-latest}" | tr -cd 'A-Za-z0-9.')"

docker build --quiet --build-arg "RUBY_VERSION=${ruby_version}" --build-arg "RAILS_VERSION=${rails_version}" \
  --tag "$image" . > /dev/null

tty=()
[[ -t 0 && -t 1 ]] && tty=(-it)
# SYS_NICE lets Docker's default seccomp profile allow set_mempolicy, which
# libvips/ImageMagick's worker threads call; otherwise it logs a warning per thread.
docker run --rm --cap-add=SYS_NICE ${tty[@]+"${tty[@]}"} "$image" "bin/${binstub}" "$@"
